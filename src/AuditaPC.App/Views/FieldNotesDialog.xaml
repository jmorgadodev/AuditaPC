<Window x:Class="AuditaPC.App.Views.FieldNotesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notas de terreno"
        Width="920"
        Height="790"
        MinWidth="720"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource PaperBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="REGISTRO DE VISITA" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="Notas de terreno" Style="{StaticResource PageTitle}" FontSize="25" Margin="0,4,0,4" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="Complementa el levantamiento con información que no puede obtenerse automáticamente. Puedes escribir libremente, dejar campos vacíos y registrar conectividad, módulos, condiciones, hallazgos y acciones." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                    <TextBlock Text="Resumen de la visita" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="VisitSummaryBox" Style="{StaticResource InputTextBox}" Height="88"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="6000"
                             ToolTip="Objetivo, alcance y contexto de la visita." />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="Conectividad y red" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ConnectivityBox" Style="{StaticResource InputTextBox}" Height="112"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="6000"
                             ToolTip="Acceso a Internet, red cableada o Wi-Fi, restricciones, enlaces y observaciones." />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Text="Aplicaciones y módulos" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ModulesBox" Style="{StaticResource InputTextBox}" Height="112"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="6000"
                             ToolTip="Sistemas, módulos, aplicaciones de negocio y pruebas realizadas." />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="Estado general" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ConditionBox" Style="{StaticResource InputTextBox}" Height="112"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="6000"
                             ToolTip="Condición física, funcionamiento, periféricos, ruidos, temperatura u otras observaciones." />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Text="Hallazgos y riesgos" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FindingsBox" Style="{StaticResource InputTextBox}" Height="112"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="6000"
                             ToolTip="Hallazgos observados durante la visita y su impacto." />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="Acciones y pendientes" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ActionPlanBox" Style="{StaticResource InputTextBox}" Height="112"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="6000"
                             ToolTip="Acciones realizadas, responsables, próximos pasos y pendientes." />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Text="Limitaciones de la visita" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="LimitationsBox" Style="{StaticResource InputTextBox}" Height="112"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="6000"
                             ToolTip="Falta de conexión, equipos apagados, permisos, módulos fuera de servicio o pruebas no realizadas." />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="Otras observaciones" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="OtherBox" Style="{StaticResource InputTextBox}" Height="96"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="6000"
                             ToolTip="Cualquier otra información que el técnico quiera dejar registrada." />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Guardar notas" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="Save_Click" Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
