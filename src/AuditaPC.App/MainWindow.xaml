<Window x:Class="AuditaPC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AuditaPC.App.ViewModels"
        xmlns:views="clr-namespace:AuditaPC.App.Views"
        Title="AuditaPC · Levantamiento técnico"
        Width="1320"
        Height="860"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        SizeChanged="OnWindowSizeChanged"
        Background="{StaticResource PaperBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
            <views:WorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra lateral -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="16,22,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="46" Height="46" Background="#22343F" CornerRadius="10" Padding="2">
                            <Image Source="pack://application:,,,/AuditaPC;component/Assets/auditapc-mark.png"
                                   Width="42" Height="42" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="10,1,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Text="AuditaPC" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Levantamiento técnico" FontSize="10.5" Foreground="{StaticResource SidebarMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{Binding SidebarToggleText}"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip="Expandir o contraer la navegación"
                            Width="28" Height="30" Padding="0"
                            FontSize="21" FontWeight="SemiBold"
                            Background="#1B2A35" BorderBrush="{StaticResource SidebarLineBrush}"
                            Foreground="#E7EDF2"
                            VerticalAlignment="Top" />
                </Grid>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="NAVEGACIÓN" FontSize="9.5" FontWeight="Bold" Foreground="#6F7F8D" Margin="10,0,0,8"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibility}}" />
                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 IsChecked="{Binding IsAuditsSelected, Mode=TwoWay}"
                                 GroupName="MainNav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,11,0" VerticalAlignment="Center" />
                            <TextBlock Text="Auditorías" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 IsChecked="{Binding IsSettingsSelected, Mode=TwoWay}"
                                 GroupName="MainNav"
                                 Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,11,0" VerticalAlignment="Center" />
                            <TextBlock Text="Configuración" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </RadioButton>

                    <Border Background="#1B2A35"
                            BorderBrush="{StaticResource SidebarLineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,22,0,0"
                            Visibility="{Binding ShowAuditContext, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="AUDITORÍA EN CURSO" FontSize="9" FontWeight="Bold" Foreground="#6F7F8D" />
                            <TextBlock Text="{Binding AuditContext}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#E7EDF2" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding StorageModeText}" FontSize="9.5"
                                       Foreground="{StaticResource SidebarMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Contenido -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        Margin="22,20,22,18"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
