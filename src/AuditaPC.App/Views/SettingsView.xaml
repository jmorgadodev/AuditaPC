<UserControl x:Class="AuditaPC.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="CONFIGURACIÓN" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="Preferencias y ubicación de datos" Style="{StaticResource PageTitle}" Margin="0,4,0,4" />
            <TextBlock Style="{StaticResource Caption}" MaxWidth="720" Margin="0,0,0,22"
                       Text="AuditaPC funciona sin instalación. La configuración y las auditorías pueden guardarse junto al ejecutable para llevar todo en un pendrive." />

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Carpeta de auditorías" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,10"
                               Text="Aquí se crean las carpetas independientes de cada auditoría. Se recomienda una carpeta escribible dentro del pendrive." />
                    <Border Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9">
                        <TextBlock Text="{Binding AuditsRoot}" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Cambiar carpeta" Style="{StaticResource SecondaryButton}" Command="{Binding ChangeFolderCommand}" />
                        <Button Content="Abrir carpeta" Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PortableText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Técnico" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,10"
                               Text="Se usa como valor predeterminado en las nuevas auditorías. Puedes cambiarlo en cada captura o ficha." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding TechnicianName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" MaxLength="120" />
                        <Button Grid.Column="1" Content="Guardar preferencias" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FineText}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Licenciamiento local y consultas online" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Comprobar conectividad HTTPS con servicios de activación de Windows y Office"
                              IsChecked="{Binding OnlineLicenseChecksEnabled, Mode=TwoWay}"
                              Margin="0,12,0,6"
                              FontSize="13"
                              Foreground="{StaticResource InkBrush}" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Desactivado por defecto. La activación local se consulta sin Internet cuando Windows lo permite (WMI) y Office mediante WMI o la herramienta local OSPP. Esta opción solo comprueba conectividad HTTPS con servicios oficiales de Microsoft para Windows y Office; no envía claves, no activa productos ni acredita titularidad o vigencia contractual. Microsoft 365 requiere autenticación o revisión del portal correspondiente." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Aplicación" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Versión" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sesión" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ElevationText}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Archivo de configuración" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SettingsFile}" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Carpeta del programa" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExecutableDirectory}" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource NoticeBorder}" Padding="18"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Avisos de inicio" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" />
                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Privacidad y alcance" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="AuditaPC no envía telemetría, no escanea la red, no modifica el sistema y no recopila contraseñas, credenciales ni claves completas. Por defecto no utiliza Internet. Solo realiza consultas HTTPS a servicios de activación de Microsoft si el técnico habilita expresamente esa opción. La información de auditoría permanece en la carpeta configurada." />
                    <Border Background="{StaticResource PaperBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Acerca de AuditaPC" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Desarrollado por Jorge Morgado"
                                       FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,5,0,0" />
                            <TextBlock Text="Levantamiento técnico e inventario de equipos"
                                       Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
