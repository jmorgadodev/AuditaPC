<Window x:Class="AuditaPC.App.Views.MatchComputerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardar captura"
        Width="860"
        Height="820"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaperBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="RESULTADO DE LA CAPTURA" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="¿A qué equipo pertenece esta captura?" Style="{StaticResource PageTitle}" FontSize="24" Margin="0,4,0,4" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="AuditaPC nunca fusiona capturas automáticamente. Confirma si la instantánea corresponde a un equipo existente o si debes crear una ficha nueva." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SnapshotName}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="{Binding SnapshotModel}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding SnapshotOs}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding SnapshotSerial}" Style="{StaticResource MonoText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="ESTADO DE LA CAPTURA" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ProblemCount, StringFormat={}{0} con problema}"
                                       Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding IncompleteCount, StringFormat={}{0} incompletas}"
                                       Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource NoticeBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding ConfidenceText}" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" />
                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Equipos parecidos en esta auditoría" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <TextBlock Text="No hay equipos registrados todavía. Se creará una ficha nueva."
                           Style="{StaticResource Caption}"
                           Margin="0,0,0,10"
                           Visibility="{Binding HasCandidates, Converter={StaticResource InverseBooleanToVisibility}}" />

                <ListBox ItemsSource="{Binding Candidates}"
                         SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding HasCandidates, Converter={StaticResource BooleanToVisibility}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root"
                                                Background="{StaticResource CardBrush}"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding ReasonsText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding ConflictsText}"
                                               Foreground="{StaticResource DangerBrush}"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"
                                               Visibility="{Binding HasConflicts, Converter={StaticResource BooleanToVisibility}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding Serial}" Style="{StaticResource MonoText}" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding AssetCode}" Style="{StaticResource MonoText}" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding LastCaptureText}" Style="{StaticResource MonoText}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="10"
                                        Padding="10,4"
                                        VerticalAlignment="Top"
                                        Margin="12,0,0,0">
                                    <TextBlock Text="{Binding ScoreText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Decisión del técnico" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <RadioButton Content="Actualizar un equipo existente"
                                     IsChecked="{Binding UpdateExisting, Mode=TwoWay}"
                                     FontSize="13"
                                     Margin="0,0,0,6" />
                        <RadioButton Content="Crear un equipo nuevo"
                                     IsChecked="{Binding CreateNew, Mode=TwoWay}"
                                     FontSize="13" />
                        <TextBlock Text="{Binding ModeHint}" Style="{StaticResource FineText}" Margin="20,6,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Código de activo (opcional)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AssetCode, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBox}"
                                         MaxLength="80" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nombre del equipo" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBox}"
                                         MaxLength="120"
                                         IsEnabled="{Binding CreateNew}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Nota de esta captura (opcional)" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                        <TextBox Text="{Binding CaptureNote, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"
                                 Height="64"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxLength="1000" />

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Descartar captura" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" IsCancel="True" />
            <Button Content="Guardar captura" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True" Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
