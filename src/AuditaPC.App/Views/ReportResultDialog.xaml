<Window x:Class="AuditaPC.App.Views.ReportResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informes generados"
        Width="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource PaperBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="INFORMES" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="Informes generados" Style="{StaticResource PageTitle}" FontSize="24" Margin="0,4,0,4" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="El informe general consolidado reúne todos los equipos, sus fichas técnicas y evidencias. Puedes abrirlo directamente, consultarlo sin conexión o guardarlo como PDF." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
            <StackPanel>
                <TextBlock Text="EXPEDIENTE QUE ACABA DE GENERAR LOS INFORMES" Style="{StaticResource Eyebrow}" />
                <TextBlock x:Name="AuditContextText" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,3,0,2" />
                <TextBlock x:Name="GeneratedAtText" Style="{StaticResource FineText}" Margin="0,0,0,16" />
                <TextBlock Text="INFORME GENERAL CONSOLIDADO · HTML" Style="{StaticResource Eyebrow}" />
                <TextBlock x:Name="HtmlPathText" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,3,0,10" />
                <Button Content="Abrir informe general consolidado"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        MinWidth="260"
                        Click="OpenHtml_Click"
                        Margin="0,0,0,18" />

                <StackPanel x:Name="IndividualReportsPanel" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock Text="INFORMES INDIVIDUALES HTML" Style="{StaticResource Eyebrow}" />
                    <TextBlock Style="{StaticResource FineText}"
                               Text="Selecciona el equipo para abrir su informe individual. El informe general incluye todos los equipos."
                               Margin="0,2,0,4" TextWrapping="Wrap" />
                    <ListBox x:Name="IndividualReportsList"
                             MaxHeight="132"
                             MinHeight="38"
                             Margin="0,4,0,6"
                             SelectionMode="Single"
                             SelectionChanged="IndividualReportsList_SelectionChanged"
                             FontSize="11" />
                    <Button x:Name="OpenIndividualButton"
                            Content="Abrir informe individual seleccionado"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right"
                            IsEnabled="False"
                            Click="OpenIndividual_Click" />
                </StackPanel>

                <TextBlock Text="INVENTARIO (CSV)" Style="{StaticResource Eyebrow}" />
                <TextBlock x:Name="SummaryPathText" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,3,0,14" />

                <TextBlock Text="SOFTWARE (CSV)" Style="{StaticResource Eyebrow}" />
                <TextBlock x:Name="SoftwarePathText" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,3,0,14" />

                <TextBlock Text="COMPROBACIONES (CSV)" Style="{StaticResource Eyebrow}" />
                <TextBlock x:Name="ChecksPathText" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,3,0,14" />

                <TextBlock Text="EXPORTACIÓN COMPLETA (JSON)" Style="{StaticResource Eyebrow}" />
                <TextBlock x:Name="JsonPathText" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Border x:Name="WarningsPanel" Grid.Row="2" Style="{StaticResource NoticeBorder}" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Avisos" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" />
                <TextBlock x:Name="WarningsText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cerrar" Style="{StaticResource SecondaryButton}" Click="Close_Click" />
            <Button Content="Abrir carpeta de informes" Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click" Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
