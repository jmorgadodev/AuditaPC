<UserControl x:Class="AuditaPC.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HomeHeader" Grid.Row="0" Margin="0,0,0,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="HomeHeaderTitle" Grid.Row="0" Grid.Column="0">
                <TextBlock Text="AUDITORÍAS" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="Auditorías guardadas" Style="{StaticResource PageTitle}" Margin="0,4,0,4" />
                <TextBlock Style="{StaticResource Caption}" MaxWidth="720"
                           Text="Cada tarjeta es un expediente independiente. Pulsa Abrir para continuar una auditoría guardada o Nueva auditoría para iniciar otra empresa, sin mezclar ni reemplazar sus equipos, capturas e informes." />
            </StackPanel>
            <StackPanel x:Name="HomeHeaderActions" Grid.Row="0" Grid.Column="1"
                        Orientation="Horizontal" VerticalAlignment="Top" Margin="20,0,0,0">
                <Button Content="Actualizar" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
                <Button Content="Nueva auditoría" Style="{StaticResource PrimaryButton}" Click="NewAudit_Click" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Buscar" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBox}"
                         MaxLength="120" />
                <Button Grid.Column="2"
                        Content="Abrir carpeta"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding OpenRootCommand}"
                        Margin="12,0,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasAudits, Converter={StaticResource BooleanToVisibility}}">
                <ItemsControl ItemsSource="{Binding AuditsView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}"
                                    Padding="18"
                                    Margin="0,0,0,10"
                                    MouseLeftButtonUp="AuditCard_Click"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Manifest.CompanyName}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0">
                                            <Run Text="{Binding Manifest.StartDate, Mode=OneWay, StringFormat={}{0:dd-MM-yyyy}}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Manifest.Technician, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding FolderName}" Style="{StaticResource MonoText}" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding Error}"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   FontSize="11.5"
                                                   Margin="0,5,0,0"
                                                   Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ComputerCountText}"
                                                   Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding LastWriteTime, StringFormat={}{0:dd-MM-yyyy HH:mm}}"
                                                   Style="{StaticResource FineText}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,0,0" />
                                        <Button Content="Abrir"
                                                Style="{StaticResource GhostButton}"
                                                Click="OpenAudit_Click"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Style="{StaticResource Card}"
                    Padding="36"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}"
                    VerticalAlignment="Top">
                <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="Todavía no hay auditorías" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,8,0,18"
                               Text="Crea la primera auditoría para registrar equipos. Los datos se guardarán en la carpeta configurada y podrás moverla junto con la aplicación." />
                    <Button Content="Crear la primera auditoría" Style="{StaticResource PrimaryButton}" Click="NewAudit_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
