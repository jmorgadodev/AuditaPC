<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AuditaPC.App</RootNamespace>
    <AssemblyName>AuditaPC</AssemblyName>
    <ApplicationIcon>Assets\auditapc.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>AuditaPC.App.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuditaPC.Core\AuditaPC.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\auditapc-mark.png" />
  </ItemGroup>

</Project>
