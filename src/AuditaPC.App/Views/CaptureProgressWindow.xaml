<Window x:Class="AuditaPC.App.Views.CaptureProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capturando este equipo"
        Width="680"
        Height="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource PaperBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="CAPTURA LOCAL" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="Consultando este equipo" Style="{StaticResource PageTitle}" FontSize="24" Margin="0,4,0,4" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="AuditaPC solo consulta el equipo local. No modifica el sistema, no se conecta a Internet y no envía datos." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <ProgressBar Height="6"
                         IsIndeterminate="{Binding IsRunning}"
                         Foreground="{StaticResource AccentBrush}"
                         Background="{StaticResource LineBrush}"
                         BorderThickness="0"
                         Value="{Binding Completed, Mode=OneWay}"
                         Maximum="8"
                         Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibility}}" />
            <Grid Margin="0,10,0,0">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource FineText}" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,10">
                <ItemsControl ItemsSource="{Binding Collectors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="74" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         Width="8" Height="8"
                                         VerticalAlignment="Top"
                                         Margin="0,5,0,0"
                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding Message}"
                                               Style="{StaticResource FineText}"
                                               Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="{Binding Status, Converter={StaticResource StatusBackground}}"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </Border>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding ElapsedText}"
                                           Style="{StaticResource MonoText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Margin="8,3,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <TextBlock Text="Las consultas WMI pueden tardar unos segundos. La captura no se guarda hasta que confirmes la ficha del equipo."
                       Style="{StaticResource FineText}"
                       VerticalAlignment="Center"
                       MaxWidth="380"
                       HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar captura"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"
                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibility}}" />
                <Button Content="Revisar resultados"
                        Style="{StaticResource PrimaryButton}"
                        Click="Continue_Click"
                        IsDefault="True"
                        Margin="10,0,0,0"
                        IsEnabled="{Binding IsFinished}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
