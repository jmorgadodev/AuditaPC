<UserControl x:Class="AuditaPC.App.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AuditaPC.App.Views"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="WorkspaceHeader" Grid.Row="0" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="WorkspaceHeaderTitle" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                <TextBlock Text="AUDITORÍA ABIERTA" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{Binding CompanyName}" Style="{StaticResource PageTitle}" Margin="0,4,0,2" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Caption}">
                    <Run Text="{Binding AuditDateText, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Run Text="{Binding TechnicianText, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Run Text="{Binding ComputerCountText, Mode=OneWay}" />
                    <Run Text=" · ID " />
                    <Run Text="{Binding AuditIdShort, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <WrapPanel x:Name="WorkspaceHeaderActions" Grid.Row="0" Grid.Column="1"
                       HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="640">
                <Button Content="Capturar este equipo" Style="{StaticResource PrimaryButton}" Command="{Binding CaptureCommand}" />
                <Button Content="Generar informes" Style="{StaticResource SecondaryButton}" Command="{Binding GenerateReportsCommand}" Margin="8,0,0,0" />
                <Button Content="{Binding FieldNotesButtonText}" Style="{StaticResource GhostButton}" Command="{Binding FieldNotesCommand}" Margin="4,0,0,0" />
                <Button Content="Recuperar capturas" Style="{StaticResource GhostButton}" Command="{Binding RecoverCommand}" Margin="4,0,0,0" />
                <Button Content="Abrir carpeta" Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" Margin="4,0,0,0" />
                <Button Content="Nueva auditoría" Style="{StaticResource GhostButton}" Command="{Binding NewAuditCommand}" Margin="4,0,0,0" />
                <Button Content="Cerrar auditoría" Style="{StaticResource GhostButton}" Command="{Binding CloseCommand}" Margin="4,0,0,0" />
            </WrapPanel>
        </Grid>

        <Grid x:Name="WorkspaceBody" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ComputerListPanel" Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="16,16,16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}"
                                     MaxLength="120" />
                            <Button Grid.Column="1" Content="Actualizar" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="EQUIPOS" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                            <Button Content="Agregar equipo manual"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding AddManualCommand}"
                                    HorizontalAlignment="Right"
                                    Padding="6,2" />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,0,8,8">
                        <ListBox ItemsSource="{Binding ComputersView}"
                                 SelectedItem="{Binding SelectedComputer, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Root" Background="Transparent" CornerRadius="7" Padding="10,9">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="#F4F2EC" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ManufacturerModel}" Style="{StaticResource FineText}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                            <TextBlock Text="{Binding OperatingSystem}" Style="{StaticResource FineText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LastCaptureText}" Style="{StaticResource FineText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <Border Background="{Binding WorstStatus, Converter={StaticResource StatusBackground}}"
                                                    CornerRadius="10"
                                                    Padding="7,2"
                                                    HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding WorstStatus, Converter={StaticResource StatusBrush}}" />
                                            </Border>
                                            <TextBlock Text="{Binding ProblemCount, StringFormat={}{0} alertas}"
                                                       Style="{StaticResource FineText}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,5,0,0"
                                                       Visibility="{Binding ProblemCount, Converter={StaticResource CountToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1"
                               Text="No hay equipos que coincidan con la búsqueda."
                               Style="{StaticResource Caption}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
            </Border>

            <Grid x:Name="ComputerDetailPanel" Grid.Row="0" Grid.Column="2">
                <ContentControl Content="{Binding Detail}" Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <views:ComputerDetailView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <Border Style="{StaticResource Card}"
                        Padding="34"
                        VerticalAlignment="Top"
                        Visibility="{Binding Detail, Converter={StaticResource InverseNullToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                        <TextBlock Text="Selecciona un equipo" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,8,0,0"
                                   Text="Elige un equipo de la lista para revisar su inventario, completar la información manual, adjuntar fotografías y consultar el historial de capturas." />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.RowSpan="2"
                Background="#B3F6F4EF"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}">
            <Border Style="{StaticResource Card}" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource SectionTitle}" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" Foreground="{StaticResource AccentBrush}" Background="{StaticResource LineBrush}" BorderThickness="0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
