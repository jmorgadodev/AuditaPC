<UserControl x:Class="AuditaPC.App.Views.ComputerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,3,14,3" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMono}" Value="True">
                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                    <Setter Property="FontSize" Value="11.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ManualBox" TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="StatCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitle}" FontSize="23" TextTrimming="CharacterEllipsis" />
                    <Border Background="{Binding WorstStatus, Converter={StaticResource StatusBackground}}"
                            CornerRadius="10"
                            Padding="9,3"
                            Margin="12,5,0,0"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{Binding WorstStatus, Converter={StaticResource StatusBrush}}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding ManufacturerModel}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Serie" Style="{StaticResource FineText}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding Serial}" Style="{StaticResource MonoText}" Margin="0,0,16,0" />
                    <TextBlock Text="Activo" Style="{StaticResource FineText}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding AssetCode}" Style="{StaticResource MonoText}" Margin="0,0,16,0" />
                    <TextBlock Text="Ubicación" Style="{StaticResource FineText}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding Location}" Style="{StaticResource MonoText}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="{Binding CaptureDateText}" Style="{StaticResource FineText}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding CapturesText}" Style="{StaticResource FineText}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                <Button Content="Abrir carpeta de la auditoría"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding OpenCaptureFolderCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <!-- Barra de resumen -->
        <Border Grid.Row="1" Style="{StaticResource SubtleCard}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding ProblemCount}" Style="{StaticResource SectionTitle}" Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Text=" con problema" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding IncompleteCount}" Style="{StaticResource SectionTitle}" Foreground="{StaticResource WarnBrush}" />
                    <TextBlock Text=" sin completar" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="4,0,0,2"
                               ToolTip="Incluye datos no verificables, consultas que requieren administrador, accesos denegados, errores o tiempos agotados. No incluye comprobaciones en línea desactivadas ni limitaciones conocidas." />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding OperatingSystem}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LastCaptureText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Style="{StaticResource MainTabControl}">
            <!-- Resumen -->
            <TabItem Header="Resumen" Style="{StaticResource MainTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="COMPROBACIONES" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="{Binding Checks.Count}" Style="{StaticResource StatValue}" Margin="0,4,0,0" />
                                    <TextBlock Text="Consultas registradas en la captura vigente." Style="{StaticResource StatCaption}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="ESTADOS A CONSIDERAR" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="{Binding ReviewChecks.Count}" Style="{StaticResource StatValue}" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" />
                                    <TextBlock Text="Problemas, permisos, consultas parciales, errores, límites conocidos y verificaciones no realizadas por falta de Internet." Style="{StaticResource StatCaption}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="FOTOGRAFÍAS" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="{Binding Photos.Count}" Style="{StaticResource StatValue}" Margin="0,4,0,0" />
                                    <TextBlock Text="Imágenes adjuntas a esta ficha, independientes de la captura." Style="{StaticResource StatCaption}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Estado por categoría" Style="{StaticResource SectionTitle}" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SubtleCard}" Padding="14" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="2"
                                                    Background="{Binding Status, Converter={StaticResource StatusBackground}}"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    Margin="12,0,0,0">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Detalle de estados y limitaciones" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                        <Border Style="{StaticResource Card}" Padding="16"
                                Visibility="{Binding HasReviewChecks, Converter={StaticResource InverseBooleanToVisibility}}">
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="No hay estados que requieran atención ni verificaciones pendientes en la captura vigente." />
                        </Border>
                        <ItemsControl ItemsSource="{Binding ReviewChecks}"
                                      Visibility="{Binding HasReviewChecks, Converter={StaticResource BooleanToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SubtleCard}" Padding="13" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource FineText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                                <TextBlock Text="{Binding StatusExplanation}" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Source}" Style="{StaticResource MonoText}" FontSize="10" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Background="{Binding Status, Converter={StaticResource StatusBackground}}"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Inventario -->
            <TabItem Header="Inventario" Style="{StaticResource MainTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{Binding Status, Converter={StaticResource StatusBackground}}"
                                                    CornerRadius="10"
                                                    Padding="9,3"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                            </Border>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,12,0,0"
                                                      Visibility="{Binding HasRows, Converter={StaticResource BooleanToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="215" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource DetailLabel}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource DetailValue}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Checks}" Margin="0,12,0,0"
                                                      Visibility="{Binding HasChecks, Converter={StaticResource BooleanToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="215" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,0,14,0" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                                            <TextBlock Text="{Binding Source}" Style="{StaticResource MonoText}" FontSize="10" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2"
                                                                Background="{Binding Status, Converter={StaticResource StatusBackground}}"
                                                                CornerRadius="9"
                                                                Padding="7,2"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding StatusText}"
                                                                       FontSize="9.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Margin="0,14,0,0"
                                                Padding="14"
                                                Background="{StaticResource PaperBrush}"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Visibility="{Binding HasPrograms, Converter={StaticResource BooleanToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ProgramsTitle}" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Text="{Binding ProgramCountText}" Style="{StaticResource Caption}" />
                                                    <TextBlock Text="El listado completo se abre en una ventana independiente para buscar, ordenar y revisar cada programa."
                                                               Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Ver programas y buscar"
                                                        Style="{StaticResource SecondaryButton}"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.OpenProgramsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Información manual -->
            <TabItem Header="Manual" Style="{StaticResource MainTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource NoticeBorder}" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="La información manual se conserva aparte de las capturas automáticas. Nunca sustituye ni modifica los datos obtenidos del equipo." />
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nombre para mostrar" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ManualDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ManualBox}" MaxLength="120" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Código de activo" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ManualAssetCode, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ManualBox}" MaxLength="80" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Responsable" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ManualResponsible, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ManualBox}" MaxLength="120" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ubicación" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ManualLocation, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ManualBox}" MaxLength="160" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Notas de terreno del equipo" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ManualNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ManualBox}" Height="80" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" />

                                <TextBlock Text="Problemas encontrados" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ManualIssues, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ManualBox}" Height="80" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" />

                                <TextBlock Text="Intervenciones realizadas" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ManualInterventions, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ManualBox}" Height="80" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" />

                                <TextBlock Text="Trabajo pendiente" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ManualPending, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ManualBox}" Height="64" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" />

                                <TextBlock Text="Recomendaciones" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ManualRecommendations, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ManualBox}" Height="80" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" />

                                <Grid Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Guardar información manual"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding SaveManualCommand}" />
                                        <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource FineText}"
                                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                    <Border Background="{StaticResource WarnSoftBrush}"
                                            CornerRadius="10"
                                            Padding="9,3"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Text="Cambios sin guardar" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Fotografías -->
            <TabItem Header="Fotos" Style="{StaticResource MainTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource Caption}"
                                   MaxWidth="640"
                                   VerticalAlignment="Center"
                                   Text="Las fotografías se guardan dentro de la carpeta de la auditoría y se incluyen en el informe HTML. No se suben a ningún servicio." />
                        <Button Content="Agregar fotografía"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddPhotoCommand}"
                                HorizontalAlignment="Right" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22"
                            VerticalAlignment="Top"
                            Visibility="{Binding HasPhotos, Converter={StaticResource InverseBooleanToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                            <TextBlock Text="Sin fotografías" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,7,0,14"
                                       Text="Puedes adjuntar imágenes del equipo, etiquetas, componentes o incidencias. Se conserva el archivo original y una copia optimizada para el informe." />
                            <Button Content="Agregar la primera fotografía"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddPhotoCommand}"
                                    HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasPhotos, Converter={StaticResource BooleanToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Photos}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SubtleCard}" Padding="0" Width="252" Margin="0,0,12,12">
                                        <StackPanel>
                                            <Grid Height="158">
                                                <Image Source="{Binding Image}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibility}}" />
                                                <Border Background="{StaticResource PaperBrush}"
                                                        Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibility}}">
                                                    <TextBlock Text="Vista previa no disponible"
                                                               Style="{StaticResource FineText}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Margin="12,10,12,12">
                                                <TextBlock Text="{Binding Description}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding FileName}" Style="{StaticResource FineText}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource FineText}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                    <Button Content="Abrir"
                                                            Style="{StaticResource GhostButton}"
                                                            Command="{Binding DataContext.OpenPhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Eliminar"
                                                            Style="{StaticResource GhostButton}"
                                                            Foreground="{StaticResource DangerBrush}"
                                                            Command="{Binding DataContext.DeletePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="8,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Historial -->
            <TabItem Header="Historial" Style="{StaticResource MainTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Caption}" Margin="0,0,0,12"
                               Text="Las capturas anteriores nunca se borran ni se sobrescriben. Puedes marcar otra captura como vigente para los informes sin perder el historial." />

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"
                            Visibility="{Binding HasHistory, Converter={StaticResource InverseBooleanToVisibility}}"
                            VerticalAlignment="Top">
                        <StackPanel Margin="24">
                            <TextBlock Text="Sin capturas automáticas" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Text="Este equipo se creó manualmente o todavía no tiene una captura guardada. Usa «Capturar este equipo» en la auditoría para registrar su inventario." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"
                            Visibility="{Binding HasHistory, Converter={StaticResource BooleanToVisibility}}">
                        <DataGrid ItemsSource="{Binding History}"
                                  Style="{StaticResource MainDataGrid}"
                                  ColumnHeaderStyle="{StaticResource MainColumnHeader}"
                                  RowStyle="{StaticResource MainDataGridRow}"
                                  CellStyle="{StaticResource MainDataGridCell}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding DateText}" Width="190" />
                                <DataGridTextColumn Header="Archivo" Binding="{Binding File}" Width="*" />
                                <DataGridTextColumn Header="SHA-256" Binding="{Binding ShortHash}" Width="150" />
                                <DataGridTextColumn Header="Versión" Binding="{Binding AppVersion}" Width="80" />
                                <DataGridTextColumn Header="Estado" Binding="{Binding CurrentText}" Width="80" />
                                <DataGridTemplateColumn Header="" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Marcar vigente"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="6,3"
                                                    Command="{Binding DataContext.SetCurrentCaptureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource InverseBooleanToVisibility}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
