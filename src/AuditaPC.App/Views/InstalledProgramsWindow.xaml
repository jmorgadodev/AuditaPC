<Window x:Class="AuditaPC.App.Views.InstalledProgramsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programas instalados"
        Width="1040"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaperBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="INVENTARIO DE SOFTWARE" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="Programas instalados" Style="{StaticResource PageTitle}" FontSize="25" Margin="0,4,0,4" />
            <TextBlock Text="Listado de aplicaciones registradas en el equipo y en el perfil del usuario actual. La búsqueda revisa nombre, versión, editor, fecha y ámbito."
                       Style="{StaticResource Caption}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTextBox}"
                     MaxLength="160"
                     ToolTip="Buscar por nombre, editor, versión, fecha o ámbito" />
            <TextBlock Grid.Column="1" Text="{Binding ResultCountText}" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" Margin="14,0" />
            <Button Grid.Column="2" Content="Limpiar" Style="{StaticResource GhostButton}"
                    Command="{Binding ClearSearchCommand}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <DataGrid ItemsSource="{Binding ProgramsView}"
                      Style="{StaticResource MainDataGrid}"
                      ColumnHeaderStyle="{StaticResource MainColumnHeader}"
                      RowStyle="{StaticResource MainDataGridRow}"
                      CellStyle="{StaticResource MainDataGridCell}"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Programa" Binding="{Binding Name}" Width="2.2*" />
                    <DataGridTextColumn Header="Versión" Binding="{Binding Version}" Width="1*" />
                    <DataGridTextColumn Header="Editor" Binding="{Binding Publisher}" Width="1.6*" />
                    <DataGridTextColumn Header="Instalación" Binding="{Binding Date}" Width="110" />
                    <DataGridTextColumn Header="Ámbito" Binding="{Binding Scope}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="No hay programas que coincidan con la búsqueda."
                       Style="{StaticResource Caption}"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}" />
            <Button Content="Cerrar" Style="{StaticResource SecondaryButton}" IsCancel="True"
                    HorizontalAlignment="Right" Padding="22,8" />
        </Grid>
    </Grid>
</Window>
